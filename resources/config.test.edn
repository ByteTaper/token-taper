{:token-taper/app
 {:service-name "token-taper"
  :service-version "0.1.0-SNAPSHOT"
  :environment "test"}

 :token-taper/http
 {:host "127.0.0.1"
  :port 0
  :join? false
  :stop-timeout-ms 1000}

 :token-taper.logging/config
 {:level :warn
  :format :json
  :include-stacktrace? false}

 :token-taper.logging/context
 {:app #ig/ref :token-taper/app
  :logging-config #ig/ref :token-taper.logging/config}

 :token-taper.system/info
 {:service "tokentaper"
  :name "TokenTaper"}

 :token-taper.observability/metrics
 {:app #ig/ref :token-taper/app
  :datasource #ig/ref :token-taper.db/datasource
  :health-config #ig/ref :token-taper.health/checks
  :git-sha "unknown"}

 :token-taper/http-server
 {:config #ig/ref :token-taper/http
  :app #ig/ref :token-taper/app
  :datasource #ig/ref :token-taper.db/datasource
  :loaded-config #ig/ref :token-taper/config
  :health-config #ig/ref :token-taper.health/checks
  :metrics #ig/ref :token-taper.observability/metrics
  :logger #ig/ref :token-taper.logging/context
  :system-info-config #ig/ref :token-taper.system/info}

 :token-taper.health/checks
 {:database-timeout-ms 1000
  :include-details? true}

 :token-taper.db/datasource
 {:jdbc-url #or [#env TOKEN_TAPER_TEST_DATABASE_URL
                 "jdbc:postgresql://localhost:5432/token_taper_test"]
  :username #or [#env TOKEN_TAPER_TEST_DATABASE_USER "token_taper"]
  :password #or [#env TOKEN_TAPER_TEST_DATABASE_PASSWORD "token_taper"]
  :pool-name "token-taper-test-db"
  :maximum-pool-size 10
  :minimum-idle 0
  :connection-timeout-ms 5000
  :validation-timeout-ms 1000
  :idle-timeout-ms 10000
  :max-lifetime-ms 30000
  :auto-commit true}

 :token-taper.db/migration
 {:migration-dir #or [#env TOKEN_TAPER_MIGRATION_DIR "migrations"]}

 :token-taper/config
 {:loaded-from "resources/config.test.edn"}}
