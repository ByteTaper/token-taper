# Local development defaults for Docker Compose (not for production).
# Copy to .env: cp .env.example .env

TOKEN_TAPER_ENV=local
TOKEN_TAPER_HTTP_PORT=8080
TOKEN_TAPER_HTTP_HOST=0.0.0.0
TOKEN_TAPER_DATABASE_URL=jdbc:postgresql://postgres:5432/tokentaper
TOKEN_TAPER_DATABASE_USER=tokentaper
TOKEN_TAPER_DATABASE_PASSWORD=tokentaper
TOKEN_TAPER_LOG_LEVEL=info
TOKEN_TAPER_LOG_FORMAT=json
TOKEN_TAPER_MIGRATION_DIR=migrations

POSTGRES_DB=tokentaper
POSTGRES_USER=tokentaper
POSTGRES_PASSWORD=tokentaper
# Host port for PostgreSQL (change if 5432 is already in use)
POSTGRES_PORT=5432
